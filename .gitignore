target/

# T-01 fixture: `target/` above and `.codegraph/` further up both match this path, so
# both must be un-excluded, in order, after the patterns that exclude them, or git
# will not re-include a file whose parent directory is still excluded.
!tests/fixtures/target/
!tests/fixtures/target/.codegraph/

# Build-loop review artifacts — per-round scratch, never committed
review.md
review.json

# agent worktrees — orchestrate creates these; they are checkouts, not content
.claude/worktrees/
