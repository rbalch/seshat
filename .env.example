# Environment variables for local development
# Copy to .env (gitignored) and fill in. Never commit secrets.

# Disable codegraph MCP telemetry.
CODEGRAPH_TELEMETRY=0

# Base URL of the vLLM server (DGX Spark), no trailing slash and no /v1 suffix.
LLM_HOST=

# Default model string for every role; hosted_vllm/qwen3.8-27b unless overridden.
#SESHAT_MODEL=

# Per-role model overrides; each defaults to SESHAT_MODEL when unset.
#SESHAT_MODEL_WORKER=
#SESHAT_MODEL_VERIFIER_AUTHOR=
#SESHAT_MODEL_REFLECTION=
#SESHAT_MODEL_ANSWER=
